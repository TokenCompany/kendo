{
  "expo": {
    "name": "Hachi-dan",
    "slug": "way-to-hachi-dan",
    "version": "1.3.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.shimafactory.waytohachidan"
    },
    "android": {
      "icon": "./assets/icon.png",
      "package": "com.shimafactory.waytohachidan",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "notification": {
      "icon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#000000"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8dd00997-bb05-42ae-a766-da9006928603"
      }
    }
  }
}
